#!/bin/sh
# Route ALSA through PulseAudio (also served by PipeWire) since the snap
# has no direct access to sound cards. The config is generated at runtime
# because plugin paths must be absolute and depend on the architecture.
triplet="$(uname -m)-linux-gnu"
plugins="$SNAP/usr/lib/$triplet/alsa-lib"
conf="$SNAP_USER_COMMON/asound.conf"

mkdir -p "$SNAP_USER_COMMON"
cat > "$conf" <<CONF
pcm_type.pulse {
    lib "$plugins/libasound_module_pcm_pulse.so"
}
ctl_type.pulse {
    lib "$plugins/libasound_module_ctl_pulse.so"
}
pcm.!default {
    type pulse
    hint.description "Default (PulseAudio)"
}
ctl.!default {
    type pulse
}
CONF

export ALSA_CONFIG_PATH="$conf"

# Warn at startup when the audio-record interface is not connected.
# snapctl prints nothing and exits 1 when the plug is simply disconnected;
# any output means snapctl itself failed, so don't nag in that case.
cmd="sudo snap connect $SNAP_INSTANCE_NAME:audio-record"
if [ -n "$DISPLAY$WAYLAND_DISPLAY" ]; then
    err="$(snapctl is-connected audio-record 2>&1)"
    if [ $? -ne 0 ] && [ -z "$err" ]; then
        while :; do
            out="$(zenity --question --title="Recording not enabled" \
                --width=480 --icon-name=audio-input-microphone \
                --text="SoundCraft cannot record audio because the <b>audio-record</b> interface is not connected.\n\nTo enable recording, run this command in a terminal, then restart SoundCraft:\n\n<tt>$cmd</tt>" \
                --ok-label="Continue" --cancel-label="Close" \
                --extra-button="Copy" 2>/dev/null)"
            if [ "$out" = "Copy" ]; then
                if [ -n "$WAYLAND_DISPLAY" ] && command -v wl-copy >/dev/null; then
                    printf %s "$cmd" | wl-copy
                elif command -v xclip >/dev/null; then
                    printf %s "$cmd" | xclip -selection clipboard
                fi
            else
                break
            fi
        done
    fi
fi

exec "$@"
